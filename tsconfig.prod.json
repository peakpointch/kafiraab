{
  "exclude": [
    "./dist/"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "html2pdf.js": [
        "node_modules/html2pdf.js/dist/html2pdf.bundle.min.js"
      ],
      "@/*": [
        "src/*"
      ]
    },
    "target": "ES2020",
    "module": "ES2020",
    "lib": [
      "es2020",
      "DOM"
    ],
    "declaration": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  }
}
